<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#315C86"/>
            <stroke android:width="3dp" android:color="#5FE8F6"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#295273"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#21324C"/>
            <stroke android:width="1dp" android:color="#334760"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>
</selector>
