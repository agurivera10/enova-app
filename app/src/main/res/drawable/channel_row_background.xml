<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2D4669"/>
            <stroke android:width="2dp" android:color="#5FE8F6"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#2D4669"/>
            <stroke android:width="2dp" android:color="#5FE8F6"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#304F70"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1B2941"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
