<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/background"
    android:orientation="vertical">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginBottom="14dp" />
    <Button
        android:id="@+id/openSports"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:text="@string/sports_section"
        android:textAllCaps="false" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:text="@string/playlist_presets"
            android:textColor="@color/text_primary"
            android:textSize="18sp"/>
        <Spinner
            android:id="@+id/playlistPresets"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="@string/playlist_presets"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/playlistUrl"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:hint="@string/url_hint"
            android:inputType="textUri"
            android:singleLine="true"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="18sp" />
        <Button
            android:id="@+id/importUrl"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:text="@string/load_url" />
        <Button
            android:id="@+id/importFile"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:text="@string/load_file" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="18dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/panel_background">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/categories"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />
            <Spinner
                android:id="@+id/groupSpinner"
                android:layout_width="match_parent"
                android:layout_height="56dp" />
            <Button
                android:id="@+id/onlyFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/only_favorites" />
            <Button
                android:id="@+id/starChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/star_channel" />
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:text="@string/empty_state" />
        </LinearLayout>
        <ListView
            android:id="@+id/channelList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/panel_background"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:focusable="true"
            android:nextFocusLeft="@id/groupSpinner"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
