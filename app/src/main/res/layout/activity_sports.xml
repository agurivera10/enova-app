<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/sports_section"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="20sp"/>
        <Button
            android:id="@+id/sportsAgendaButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sports_agenda"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/sportsChannelsButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sports_channels"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/sportsReloadButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sports_reload"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/sportsBrowserButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sports_browser"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/sportsBackButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/sports_back"
            android:textAllCaps="false"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/sportsProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/sportsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/sports_initial"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"/>
    <WebView
        android:id="@+id/sportsWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/panel"
        android:focusable="true"
        android:focusableInTouchMode="true"/>
</LinearLayout>
